{
  "version": "3.1",
  "data_api_version": "3.0",
  "routing_model": {
    "ONBOARDING_WELCOME": [
      "ONBOARDING_TCS"
    ],
    "ONBOARDING_TCS": [
      "OPEN_TRANSFER_HOME"
    ],
    "OPEN_TRANSFER_HOME": [
      "SERVICES_MENU",
      "INVESTMENT_TRACKER",
      "SETTINGS"
    ],
    "SERVICES_MENU": [
      "BUY_BUNDLES",
      "PAY_UTILITIES",
      "P2P_TRANSFER",
      "PAY_MERCHANT",
      "SHARE_APP"
    ],
    "BUY_BUNDLES": [
      "CONFIRMATION_SCREEN"
    ],
    "PAY_UTILITIES": [
      "CONFIRMATION_SCREEN"
    ],
    "P2P_TRANSFER": [
      "P2P_VERIFY_NAME"
    ],
    "P2P_VERIFY_NAME": [
      "CONFIRMATION_SCREEN"
    ],
    "PAY_MERCHANT": [
      "CONFIRMATION_SCREEN"
    ],
    "SHARE_APP": [
      "CONFIRMATION_SCREEN"
    ],
    "SETTINGS": [
      "STOCK_SELECTION"
    ],
    "STOCK_SELECTION": [],
    "INVESTMENT_TRACKER": [],
    "CONFIRMATION_SCREEN": []
  },
  "screens": [
    {
      "id": "ONBOARDING_WELCOME",
      "title": "Welcome to OpenTransfer",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Akaunti Inayofanya Kazi Kama Benki Yako"
          },
          {
            "type": "TextBody",
            "text": "Mabenki yanatengenezaje faida? Wanachukua pesa yako, wanaikopesha kwa wengine kwa riba, kisha wanaweka faida yote mfukoni kwao."
          },
          {
            "type": "TextBody",
            "text": "Sisi OpenTransfer tumegeuza mchezo. Ukilipa LUKU au ukituma pesa, ile kamisheni ambayo Tanesco inatulipa sisi tunaiweka kwenye Akaunti yako. Kisha tunaipeleka kwenye masoko ya dunia kukopesha, na tukipata Riba, inarudi kwako kama Dola."
          },
          {
            "type": "TextBody",
            "text": "Mtu mwerevu hafanyi miamala na kuachia wengine tozo. Karibu OpenTransfer."
          },
          {
            "type": "Footer",
            "label": "Proceed",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "ONBOARDING_TCS"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ONBOARDING_TCS",
      "title": "Terms & Conditions",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "User Agreement"
          },
          {
            "type": "TextBody",
            "text": "By proceeding, you agree to our Terms. OpenTransfer is a loyalty program. We accumulate transaction commissions on your behalf, which are lent to secure global markets (Stablecoin Liquidity Pools) to generate yield. You do not hold direct bank accounts or public securities."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "CheckboxGroup",
                "name": "terms_agreement",
                "required": true,
                "choices": [
                  {
                    "id": "agree",
                    "title": "I accept the Terms & Conditions"
                  }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Accept & Continue",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "OPEN_TRANSFER_HOME"
              }
            }
          }
        ]
      }
    },
    {
      "id": "OPEN_TRANSFER_HOME",
      "title": "OpenTransfer Hub",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "OpenTransfer"
          },
          {
            "type": "TextBody",
            "text": "The Financial Operating System. Zero friction. Zero extra fees."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "home_menu",
                "label": "Select Module",
                "required": true,
                "choices": [
                  {
                    "id": "SERVICES_MENU",
                    "title": "Payments & Services"
                  },
                  {
                    "id": "INVESTMENT_TRACKER",
                    "title": "Wealth Portfolio"
                  },
                  {
                    "id": "SETTINGS",
                    "title": "Account Settings"
                  }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Launch Module",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "${form.home_menu}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SERVICES_MENU",
      "title": "Services Directory",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Select Transaction"
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "service_category",
                "label": "Categories",
                "required": true,
                "choices": [
                  {
                    "id": "P2P_TRANSFER",
                    "title": "Transfer Funds"
                  },
                  {
                    "id": "BUY_BUNDLES",
                    "title": "Airtime & Bundles"
                  },
                  {
                    "id": "PAY_UTILITIES",
                    "title": "Utilities & Government"
                  },
                  {
                    "id": "PAY_MERCHANT",
                    "title": "Pay Merchant (QR / Lipa Namba)"
                  }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Proceed",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "${form.service_category}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "BUY_BUNDLES",
      "title": "Data & Bundles",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Select your network and exact bundle. (Note: In production, these dropdowns fetch real-time from Selcom API based on the entered number)."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextInput",
                "name": "phone_number",
                "label": "Phone Number (Starts with 07.. or 06..)",
                "required": true,
                "input_type": "number"
              },
              {
                "type": "Dropdown",
                "name": "bundle_type",
                "label": "Select Exact Bundle",
                "required": true,
                "choices": [
                  { "id": "airtime", "title": "Airtime (Enter amount next screen)" },
                  { "id": "daily_1", "title": "Daily: 1GB - TZS 1,000" },
                  { "id": "weekly_1", "title": "Weekly: 1GB + 100 Min - TZS 3,000" },
                  { "id": "weekly_2", "title": "Weekly: 4.5GB - TZS 5,000" },
                  { "id": "monthly_1", "title": "Monthly: 12GB - TZS 10,000" },
                  { "id": "monthly_2", "title": "Monthly: 30GB + 300 Min - TZS 20,000" },
                  { "id": "night_1", "title": "Night Bundle: 5GB - TZS 1,500" }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Review Order",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "CONFIRMATION_SCREEN"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PAY_UTILITIES",
      "title": "Utilities & GePG",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "Dropdown",
                "name": "utility_type",
                "label": "Utility Provider",
                "required": true,
                "choices": [
                  { "id": "luku", "title": "LUKU (Electricity)" },
                  { "id": "dawasa", "title": "DAWASA (Water)" },
                  { "id": "tukuza", "title": "Zanzibar Electricity (TUKUZA)" },
                  { "id": "dstv", "title": "DSTV" },
                  { "id": "azamtv", "title": "Azam TV" },
                  { "id": "zuku", "title": "Zuku TV" },
                  { "id": "startimes", "title": "Startimes" },
                  { "id": "traffic_fines", "title": "Police Traffic Fines" },
                  { "id": "tra", "title": "Tanzania Revenue Authority (TRA)" },
                  { "id": "gepg_other", "title": "Government Payments (GePG)" }
                ]
              },
              {
                "type": "TextInput",
                "name": "account_number",
                "label": "Account / Meter / Reference Number",
                "required": true,
                "input_type": "text"
              },
              {
                "type": "TextInput",
                "name": "amount",
                "label": "Amount (TZS)",
                "required": true,
                "input_type": "number"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Review Payment",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "CONFIRMATION_SCREEN"
              }
            }
          }
        ]
      }
    },
    {
      "id": "P2P_TRANSFER",
      "title": "Transfer Funds",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Enter the recipient's details to verify their identity before routing."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "Dropdown",
                "name": "transfer_type",
                "label": "Destination Network",
                "required": true,
                "choices": [
                  { "id": "vodacom", "title": "M-Pesa" },
                  { "id": "tigo", "title": "Tigo Pesa" },
                  { "id": "airtel", "title": "Airtel Money" },
                  { "id": "halotel", "title": "HaloPesa" },
                  { "id": "crdb", "title": "CRDB Bank" },
                  { "id": "nmb", "title": "NMB Bank" },
                  { "id": "nbc", "title": "NBC Bank" },
                  { "id": "equity", "title": "Equity Bank" },
                  { "id": "pbz", "title": "PBZ Bank" },
                  { "id": "kcb", "title": "KCB Bank" },
                  { "id": "stanbic", "title": "Stanbic Bank" },
                  { "id": "dtb", "title": "DTB Bank" }
                ]
              },
              {
                "type": "TextInput",
                "name": "recipient_number",
                "label": "Mobile or Bank Account Number",
                "required": true,
                "input_type": "number"
              },
              {
                "type": "TextInput",
                "name": "amount",
                "label": "Amount (TZS)",
                "required": true,
                "input_type": "number"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Verify Recipient",
            "on_click_action": {
              "name": "data_exchange",
              "payload": {
                "action": "resolve_name",
                "recipient_number": "${form.recipient_number}",
                "network": "${form.transfer_type}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "P2P_VERIFY_NAME",
      "title": "Verify Recipient",
      "terminal": false,
      "data": {
        "recipient_name": {
          "type": "string",
          "__example__": "JOHN DOE"
        },
        "network": {
          "type": "string",
          "__example__": "M-PESA"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Recipient Identity"
          },
          {
            "type": "TextBody",
            "text": "Name: ${data.recipient_name}\nNetwork: ${data.network}"
          },
          {
            "type": "TextBody",
            "text": "Please confirm these details match your intended recipient."
          },
          {
            "type": "Footer",
            "label": "Confirm & Proceed",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "CONFIRMATION_SCREEN"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PAY_MERCHANT",
      "title": "Merchant Payments",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "Dropdown",
                "name": "merchant_method",
                "label": "Payment Method",
                "required": true,
                "choices": [
                  { "id": "lipa_namba", "title": "Enter Lipa Namba (Till Number)" },
                  { "id": "qr_code", "title": "Scan QR Code" }
                ]
              },
              {
                "type": "TextInput",
                "name": "merchant_number",
                "label": "Lipa Namba (Leave blank if QR)",
                "required": false,
                "input_type": "number"
              },
              {
                "type": "TextInput",
                "name": "amount",
                "label": "Amount (TZS)",
                "required": true,
                "input_type": "number"
              }
            ]
          },
          {
            "type": "TextBody",
            "text": "Note: For QR code processing, submit this form to initialize the native camera scanner within the chat."
          },
          {
            "type": "Footer",
            "label": "Proceed",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "CONFIRMATION_SCREEN"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SHARE_APP",
      "title": "Share OpenTransfer",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Expand Your Network"
          },
          {
            "type": "TextBody",
            "text": "Distribute your unique OpenTransfer invitation directly to your WhatsApp Status or private contacts to grow the ecosystem."
          },
          {
            "type": "Footer",
            "label": "Generate Link",
            "on_click_action": {
              "name": "complete",
              "payload": {
                "action": "generate_share_link"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SETTINGS",
      "title": "System Settings",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Preferences & Accessibility"
          },
          {
            "type": "TextBody",
            "text": "For rapid access, navigate to your main WhatsApp chat list, tap and hold the OpenTransfer thread, and pin it to 'Important' or 'Payments'."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "settings_menu",
                "label": "Configuration",
                "required": true,
                "choices": [
                  {
                    "id": "STOCK_SELECTION",
                    "title": "Manage Equities & Assets"
                  }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Configure",
            "on_click_action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "${form.settings_menu}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "STOCK_SELECTION",
      "title": "Asset Configuration",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Equity Allocation"
          },
          {
            "type": "TextBody",
            "text": "Browse the European API catalog. Select the primary asset to track your accumulated transaction commissions."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "Dropdown",
                "name": "chosen_stock",
                "label": "Select Asset",
                "required": true,
                "choices": [
                  { "id": "api_catalog", "title": "Load API Catalog..." }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Save Configuration",
            "on_click_action": {
              "name": "complete",
              "payload": {
                "action": "save_asset_preference"
              }
            }
          }
        ]
      }
    },
    {
      "id": "INVESTMENT_TRACKER",
      "title": "Dollar Yield Reserve",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Your Financial Vault"
          },
          {
            "type": "TextBody",
            "text": "Current Global Yield Rate: 5.2% APY"
          },
          {
            "type": "TextBody",
            "text": "Total Dollar Equivalent: USD 14.50"
          },
          {
            "type": "TextBody",
            "text": "Recent transactions generated USD 0.15 in commissions. This amount has been lent to global liquidity pools and is currently earning interest."
          },
          {
            "type": "Footer",
            "label": "Close Vault",
            "on_click_action": {
              "name": "complete",
              "payload": {
                "action": "viewed_portfolio"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONFIRMATION_SCREEN",
      "title": "Review Order",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Ready to Execute"
          },
          {
            "type": "TextBody",
            "text": "You will receive an authorization prompt on your device. Zero extra fees apply."
          },
          {
            "type": "TextBody",
            "text": "Your transaction commission will automatically be credited to your selected asset."
          },
          {
            "type": "Footer",
            "label": "Authorize Payment",
            "on_click_action": {
              "name": "complete",
              "payload": {
                "action": "execute_stk_push"
              }
            }
          }
        ]
      }
    }
  ]
}